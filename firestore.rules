rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de usuario: Solo el dueño edita, pero otros pueden buscar por correo para transferencias
    match /usuarios/{userId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null; // Permitir buscar destinatarios por email
    }

    // Sistema de Transferencias Colaborativas
    match /transferencias/{transId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUid || 
        request.auth.uid == resource.data.toUid
      );
    }

    // Datos privados por usuario (Ruta: /users/{userId}/...)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla temporal para permitir la MIGRACIÓN inicial de las colecciones globales
    // (Permite leer de las colecciones antiguas para copiar los datos)
    match /proveedores/{id} { allow read: if request.auth != null; allow write: if false; }
    match /productos/{id}   { allow read: if request.auth != null; allow write: if false; }
    match /clientes/{id}    { allow read: if request.auth != null; allow write: if false; }
    match /compras/{id}     { allow read: if request.auth != null; allow write: if false; }
    match /ventas/{id}      { allow read: if request.auth != null; allow write: if false; }
    match /vendedores/{id}  { allow read: if request.auth != null; allow write: if false; }
    match /settings/{id}    { allow read: if request.auth != null; allow write: if false; }

    // Regla de respaldo antigua (por si acaso, mientras terminas la migración)
    // Una vez que todos migren, esto se puede borrar
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 6, 1);
    }
  }
}
